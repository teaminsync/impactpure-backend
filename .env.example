# Server-side secrets. Never commit real values. Copy to .env for local work.
# MONGODB_URI must end right after the host name. The code appends "/e-commerce" itself,
# so the value must have no path and no query string.
# Do NOT run the backend locally with the production URI.
MONGODB_URI=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
EMAIL_USER=
EMAIL_PASS=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_ORDER_LENGTH=
SHIPROCKET_ORDER_BREADTH=
SHIPROCKET_ORDER_HEIGHT=
SHIPROCKET_ORDER_WEIGHT=
SHIPROCKET_ORIGIN_PINCODE=
# Public host of this same backend (used for the internal invoice call).
BACKEND_API_BASE_URL=
# Local runs only (not needed on Vercel).
PORT=
